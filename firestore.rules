rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'staff';
    }

    function validMenuItem(data) {
      return data.keys().hasOnly(['name', 'category', 'price', 'available'])
        && data.keys().hasAll(['name', 'category', 'price', 'available'])
        && data.name is string
        && data.category is string
        && data.price is number
        && data.available is bool;
    }

    function validUserProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'phone', 'address', 'photoUrl'])
        && (!changed.hasAny(['name'])
          || request.resource.data.name is string)
        && (!changed.hasAny(['phone'])
          || request.resource.data.phone is string)
        && (!changed.hasAny(['address'])
          || request.resource.data.address is string)
        && (!changed.hasAny(['photoUrl'])
          || request.resource.data.photoUrl is string);
    }

    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'phone', 'address', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'role', 'phone', 'address', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role in ['student', 'staff']
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.photoUrl is string;
      allow update: if ownsUser(userId) && validUserProfileUpdate();
    }

    match /menu_items/{menuId} {
      allow read: if signedIn();
      allow create: if isStaff() && validMenuItem(request.resource.data);
      allow update: if isStaff()
        && validMenuItem(request.resource.data);
      allow delete: if isStaff();
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'items', 'total', 'pickupNote', 'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'userEmail', 'items', 'total', 'pickupNote', 'status',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.pickupNote is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if (
        isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'preparing')
          || (resource.data.status == 'preparing'
            && request.resource.data.status == 'ready')
          || (resource.data.status == 'ready'
            && request.resource.data.status == 'completed')
        )
      ) || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pickupNote'])
        && request.resource.data.pickupNote is string
      );
      allow delete: if isStaff() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
